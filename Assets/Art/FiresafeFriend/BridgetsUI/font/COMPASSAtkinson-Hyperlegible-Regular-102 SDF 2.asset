    characterSetSelectionMode: 8
    characterSequence: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html>\n<head>\n 
      <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n 
      <meta http-equiv=\"Content-Style-Type\" content=\"text/css\">\n  <title></title>\n 
      <meta name=\"Generator\" content=\"Cocoa HTML Writer\">\n  <meta name=\"CocoaVersion\"
      content=\"2487.3\">\n  <style type=\"text/css\">\n    p.p1 {margin: 0.0px 0.0px
      0.0px 0.0px; font: 13.0px 'PingFang SC'; -webkit-text-stroke: #000000}\n   
      span.s1 {font-kerning: none}\n  </style>\n</head>\n<body>\n<p class=\"p1\"><span
      class=\"s1\">\u307E\u305F\u3001\u3042\u306E\u5922\u3092\u898B\u3066\u3044\u308B</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3042\u306E\u77AC\u9593\u306B\u82E6\u3057\u3044\u4E8B\u3068\u3001\u5F8C\u6094\u306E\u4E8B\u3092\u611F\u3058\u305F\u5922\u3060</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3053\u3093\u306A\u306B\u65E9\u304F\u72B6\u6CC1\u304C\u5909\u308F\u308B\u3068\u306F\u601D\u308F\u306A\u304B\u3063\u305F\u3002</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3082\u3046\uFF13\u9031\u9593\u3082\u7D4C\u3063\u305F\u306E\u306B\u3001\u4FFA\u306F\u307E\u3060\u3053\u3093\u306A\u4E8B\u3092\u7406\u89E3\u3059\u308B\u306E\u306F\u5927\u5909\u3060</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u884C\u304B\u306A\u3044\u3067</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u541B\u306B\u3042\u3093\u306A\u4E8B\u3092\u8A00\u308F\u306A\u3051\u308C\u3070</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3042\u306E\u591C\u304C\u3001\u541B\u3068\u8A71\u3059\u6700\u5F8C\u306E\u6642\u9593\u3060\u3068\u77E5\u3063\u3066\u3044\u305F\u3089</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u541B\u3092\u898B\u308B\u3001\u541B\u3092\u30CF\u30B0\u3059\u308B</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3054\u3081\u3093\u3001\u6BCD\u3055\u3093</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u6BCD\u3055\u3093\u306B\u8B1D\u308A\u305F\u3044</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u6BCD\u3055\u3093\u3001\u3053\u306E\u4E16\u3092\u53BB\u3089\u306A\u3044\u3067</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u30DE\u30DE\u304C\u3044\u306A\u3044\u306A\u3089\u3001\u4F55\u3092\u3059\u308B\u306E\u304B\u5206\u304B\u3089\u306A\u3044</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u51B7\u3084\u6C57\u3092\u304B\u3044\u3066\u3001\u76EE\u304C\u899A\u3081\u305F</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u3081\u307E\u3044\u304C\u3057\u3066\u3001\u30D9\u30C3\u30C9\u306B\u5EA7\u308D\u3046\u3068\u3059\u308B</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u300C\u6C34\u3001\u98F2\u307F\u305F\u3044\u3002\u3002\u3002\u300D\u30A2\u30C7\u30A3\u30BD\u30F3</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u8D77\u304D\u305F\u3089\u3059\u3050\u306B\u3001\u90E8\u5C4B\u306E\u53CD\u5BFE\u5074\u304B\u3089\u5909\u3060\u304C\u3001\u89AA\u3057\u3044\u5B58\u5728\u306B\u6C17\u3065\u3044\u305F</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u062F\u0648\u0628\u0627\u0631\u0647 \u062F\u0627\u0631\u0645
      \u062E\u0648\u0627\u0628 \u0645\u06CC\u0628\u06CC\u0646\u0645. #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u062F\u0648\u0628\u0627\u0631 \u0627\u06CC\u0646
      \u062D\u0633 \u0644\u0639\u0646\u062A\u06CC\u060C \u0627\u0641\u0633\u0648\u0633
      \u0627\u0648\u0646 \u0644\u062D\u0638\u0647. #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">... #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0647\u06CC\u0686\u0648\u0642\u062A \u0641\u06A9\u0631
      \u0646\u0645\u06CC\u06A9\u0631\u062F\u0645 \u062F\u0646\u06CC\u0627\u0645 \u0686\u0642\u062F\u0631
      \u0633\u0631\u06CC \u0645\u06CC\u062A\u0648\u0646\u0647 \u0639\u0648\u0636
      \u0634\u0647. #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0628\u0627 \u0627\u06CC\u0646\u06A9\u0647
      \u06F3 \u0647\u0641\u062A\u0647 \u06AF\u0630\u0634\u062A\u0647\u060C \u0647\u0646\u0648\u0632
      \u0628\u0627\u0648\u0631 \u06A9\u0631\u062F\u0646\u0634 \u0628\u0631\u0627\u0645
      \u0633\u062E\u062A\u0647. #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">#speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0644\u0637\u0641\u0627 \u0646\u0631\u0648\u060C
      \u062A\u0646\u0647\u0627\u0645 \u0646\u0632\u0627\u0631 #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0627\u06CC \u06A9\u0627\u0634 \u0627\u0648\u0646
      \u062D\u0631\u0641\u0627\u0631\u0648 \u0628\u0647\u062A \u0646\u0645\u06CC\u0632\u062F\u0645.
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u0627\u06AF\u0647 \u0641\u0642\u0637 \u0645\u06CC \u062F\u0648\u0646\u0633\u062A\u0645
      \u06A9\u0647 \u0627\u0648\u0646 \u0634\u0628 \u0622\u062E\u0631\u06CC\u0646
      \u0634\u0628\u06CC \u0647\u0633\u062A \u06A9\u0647 \u0645\u06CC\u062F\u06CC\u062F\u0645\u062A\u2026
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u0628\u063A\u0644\u062A \u0645\u06CC\u06A9\u0631\u062F\u0645
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u0645\u0646\u0648 \u0628\u0628\u062E\u0634 \u0645\u0627\u0645\u0627\u0646
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u0627\u06CC \u06A9\u0627\u0634 \u0645\u06CC\u200C\u0634\u062F
      \u0647\u0645\u0647 \u0686\u06CC \u0628\u0631\u06AF\u0631\u062F\u0647 #speaker:
      \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span class=\"s1\">\u0627\u06CC
      \u06A9\u0627\u0634 \u0645\u06CC\u200C\u0634\u062F \u06CC\u06A9\u0628\u0627\u0631
      \u062F\u06CC\u06AF\u0647 \u0645\u06CC\u062F\u06CC\u062F\u0645\u0634. #speaker:
      \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span class=\"s1\">\u0646\u0645\u06CC\u200C\u062F\u0648\u0646\u0645
      \u0628\u062F\u0648\u0646 \u062A\u0648 \u0686\u06CC\u06A9\u0627\u0631 \u06A9\u0646\u0645.
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u0627\u0645\u0631\u0648\u0632 \u0628\u0627 \u06CC\u0647 \u0644\u0631\u0632\u06CC
      \u062A\u0648 \u0628\u062F\u0646\u0645 \u0628\u06CC\u062F\u0627\u0631 \u0634\u062F\u0645.
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p class=\"p1\"><span
      class=\"s1\">\u062D\u0627\u0644\u0645 \u0627\u0635\u0644\u0627 \u062E\u0648\u0628
      \u0646\u06CC\u0633\u062A\u060C \u0645\u06CC \u062E\u0648\u0627\u0645 \u0628\u0644\u0646\u062F
      \u0634\u0645 \u0648\u0627\u06CC \u0646\u0645\u06CC\u200C\u062A\u0648\u0646\u0645.</span></p>\n<p
      class=\"p1\"><span class=\"s1\">#speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0628\u0630\u0627\u0631 \u06CC\u0647 \u0644\u06CC\u0648\u0627\u0646
      \u0622\u0628 \u0628\u062E\u0648\u0631\u0645 \u0634\u0627\u06CC\u062F \u062D\u0627\u0644\u0645
      \u062C\u0627 \u0628\u06CC\u0627\u062F #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n<p
      class=\"p1\"><span class=\"s1\">\u0628\u0647 \u0645\u062D\u0636 \u0627\u06CC\u0646\u06A9\u0647
      \u0628\u0644\u0646\u062F \u0634\u062F\u0645\u060C \u0627\u062D\u0633\u0627\u0633
      \u06A9\u0631\u062F\u0645 \u06CC\u0647 \u0646\u0641\u0631 \u062F\u06CC\u06AF\u0647
      \u0647\u0645 \u0628\u0627 \u0645\u0646 \u062A\u0648 \u0627\u062A\u0627\u0642\u0647!
      #speaker: \u0627\u062F\u06CC\u0633\u0648\u0646</span></p>\n</body>\n</html>\n"
