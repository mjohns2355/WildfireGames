  localNewsPanel2: {fileID: 1076062183}
  beforefirstSimDialog:
    messages:
    - We want to learn from the past fires what we can do better. This simulation
      shows the most recent fire in our community.
    - Press the Play button at the top of the screen to start the simulation. The
      simulation will run at 2x speed.
    images:
    - {fileID: 0}
    - {fileID: 0}
  afterfirstSimDialog:
    messages:
    - 'The first car reach the shelter after [time] and the final car reached the
      shelter after [time].  Can you do better? '
    images:
    - {fileID: 0}
  phaseOneDialog:
    messages:
    - 'Time to prepare! A fire has started to the Northwest and our community is
      in danger! '
    - Some households need to make considerations for their situation, and everyone
      needs to prepare to evacuate.
    - 'Give instructions to each house to help them make the best decision. '
    - 'Tap the question mark button at the top of the screen to learn more about
      each house type and unlock more options. '
    - 'Once you have given instructions to each house type, press the play button
      at the top to run the simulation and see the evacuation. '
    - 'Remember that winds can change quickly, making fire direction difficult to
      predict, and embers can be blown long distances to catch houses on fire. '
    images: []
  winDialog:
    messages:
    - 'The first car reach the shelter after [time] and the final car reached the
      shelter after [time].  '
    - 'A local news story has more details based on your choices. '
    - "This was better than before! Let\u2019s try with a different community."
    images:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  loseDialog:
    messages:
    - 'The first car reach the shelter after [time] and the final car reached the
      shelter after [time].  '
    - 'A local news story has more details based on your choices. '
    - " This was was not a very good result, let\u2019s try again and see if we can
      do better. "
    images:
    - {fileID: 0}
    - {fileID: 0}
    - {fileID: 0}
  dialogButton: {fileID: 221128385}
  nextButton: {fileID: 1251916340}
  localNewsCloseButton: {fileID: 1763659539}
  localNews: {fileID: 1907075366}
  dialogBoxButton: {fileID: 221128385}
  dialogBox: {fileID: 1741150769}
  newsImage: {fileID: 2137018255}
  endQuoteData:
    quotes: []
  isInstructionShown: 0
  endQuotesNum: 0
