--- !u!114 &1370801432
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1370801426}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61ada742c94545f4084fa59506f2e3a1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  phaseOneDialog:
  - 'Today you are pet-sitting for a friend while they are out of town. '
  - 'But you just heard on the news that a fire has started in your area. '
  - "You can\u2019t reach your friend because they are not answering their phone. "
  - 'Even though there is not an evacuation notice yet, you know that things can
    change quickly. '
  - 'You know how hard it would be for your friend if their belongings were lost
    in a fire. '
  - "It\u2019s always best to be prepared, so try to gather the things you think
    would be important, just in case. "
  - 'Remember practical things like pets and pet food, water, and prescriptions,
    but also sentimental things like photo albums. '
  - "Even though you have time now, remember if an evacuation notice happens you
    need to get out as quickly as possible and can\u2019t stop for non-essentials. "
  - "Here\u2019s a map of your friend\u2019s house to help you get oriented. Good
    luck! "
  endDialog: []
  dialog: {fileID: 612391758}
  houseDestroyed: 0
  acresDestroyed: 0
  done: 0
  images:
  - {fileID: 1619861549}
  - {fileID: 1201383852}
  - {fileID: 1525331299}
  - {fileID: 1201383852}
