  m_Script: {fileID: 11500000, guid: 3f0d0e153d21a764da1ca6e6ba5afa2a, type: 3}
  m_Name: WUIHouse
  m_EditorClassIdentifier: 
  houseType: 6
  menuTitle: Near Wildland
  normalChoices:
  - choiceName: Wait for Notice
    carNumberMod: 0
    carSpawnTimeMod: 3
    horseNumberMod: 0
    kidNumberMod: 0
    petNumberMod: 0
    homeHardeningMod: 0
    carSpeedMod: 2
    choiceDetail: 
    endGameFeedback: A number of households along the Wildland Urban Interface were
      not ready and managed to evacuate only just in time.
    isLocked: 0
  lockedChoices:
  - choiceName: Evacuate Early
    carNumberMod: 0
    carSpawnTimeMod: -1
    horseNumberMod: 0
    kidNumberMod: 0
    petNumberMod: 0
    homeHardeningMod: 0
    carSpeedMod: 2
    choiceDetail: Houses in the Wildland Urban Interface are at higher risk. Evacuating
      early, even when there isn't an evacuation order, is the safe choice.
    endGameFeedback: Houses along the Wildland Urban Interface were ready and knew
      to evacuate without waiting for a notice.
    isLocked: 1
  - choiceName: Home Hardening
    carNumberMod: 0
    carSpawnTimeMod: 0
    horseNumberMod: 0
    kidNumberMod: 0
    petNumberMod: 0
    homeHardeningMod: 0.8
    carSpeedMod: 2
    choiceDetail: 'Home hardening can help prevent a house from catching fire. This
      includes things like replacing the roof with nonflamable materials and clearing
      vegetation. '
    endGameFeedback: Households in the Wildland Urban Interface benefited from home
      hardening awareness, and many of those houses were unburned.
    isLocked: 1
  longerTitle: Near Wildland
  description: 'Living at the Wildland Urban Interface comes with risks and challenges.
    It is very important to take action early and to consider multiple scenarios
    and consequences of choices. Long before fire season, consider hardening your
    home and creating a defensible space. Be sure you have a Go Bag and a plan for
    your belongings. Consider evacuating early before an evacuation notice to protect
    yourself and reduce risk.

'
  carNumber: 1
  horseNumber: 0
  petNumber: 0
  kidNumber: 0
  carSpeed: 1
  carSpawnTime: 1
