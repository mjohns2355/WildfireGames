    {
      "key": "learnMoreTitleText",
      "text_en": "Learn More",
      "text_es": "Aprender Más",
      "audioPath": "FindYourThings/Audio/learnMoreTitle",
      "audioPathES": "FindYourThings/Audio/ES/learnMoreTitle"
    },
    {
      "key": "learnMoreDesc1Text",
      "text_en": "Want to learn more about preparing for wildfires?",
      "text_es": "¿Quieres aprender más sobre cómo prepararte para los incendios forestales?",
      "audioPath": "FindYourThings/Audio/learnMoreDesc1",
      "audioPathES": "FindYourThings/Audio/ES/learnMoreDesc1"
    },
    {
      "key": "learnMoreDesc2Text",
      "text_en": "If you live in an area that has some fire risk, like in a Wildland-Urban Interface, you may have a local Fire Safe Council or Firewise Community that has information specific to your area.",
      "text_es": "Si vives en un área con riesgo de incendios, como una zona de Interfaz Urbano-Forestal, es posible que haya un Consejo de Seguridad contra Incendios o una comunidad Firewise con información específica para tu área.",
      "audioPath": "FindYourThings/Audio/learnMoreDesc2",
      "audioPathES": "FindYourThings/Audio/ES/learnMoreDesc2"
    },
    {
      "key": "learnMoreDesc3Text",
      "text_en": "Here are some resources to help you get started.",
      "text_es": "Aquí hay algunos recursos para ayudarte a comenzar.",
      "audioPath": "FindYourThings/Audio/learnMoreDesc3",
      "audioPathES": "FindYourThings/Audio/ES/learnMoreDesc3"
    },
